{
  "name": "school-timetable",
  "version": "1.5.0",
  "private": true,
  "scripts": {
    "dev": "node scripts/write-version.mjs && next dev",
    "build": "node scripts/write-version.mjs && next build",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "seed": "node scripts/seed.mjs",
    "cap:sync": "npm run build && cap sync android",
    "android:open": "cap open android",
    "android:apk": "npm run build && cap sync android && cd android && ./gradlew assembleDebug && echo \"APK: android/app/build/outputs/apk/debug/app-debug.apk\"",
    "android:icons": "capacitor-assets generate --android --iconBackgroundColor '#2459c9' --splashBackgroundColor '#f8fafc'"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/core": "^8.6.0",
    "@capacitor/status-bar": "^8.0.4",
    "@supabase/supabase-js": "2.47.10",
    "next": "15.1.6",
    "react": "19.0.0",
    "react-dom": "19.0.0"
  },
  "devDependencies": {
    "@capacitor/assets": "^4.0.0",
    "@capacitor/cli": "^8.6.0",
    "@types/node": "22.10.2",
    "@types/react": "19.0.2",
    "@types/react-dom": "19.0.2",
    "autoprefixer": "10.4.20",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.7.2"
  }
}
